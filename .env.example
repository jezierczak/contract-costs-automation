WORK_DIR=./work_dir

# Fernet key used to encrypt secrets at rest (e.g. KSeF certificate password).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KSEF_SECRETS_KEY=<generate one, see above>

KSEF_IMPORT_MODE=http

