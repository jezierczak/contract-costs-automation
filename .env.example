APP_ENV=test

OPENAI_API_KEY=<type your api key>

DB_BACKEND=mysql
DB_HOST=localhost
DB_PORT=3306
MYSQL_ROOT_PASSWORD=root
DB_NAME=contract_costs
DB_USER=user
DB_PASSWORD=change_me

WORK_DIR=./work_dir

# Fernet key used to encrypt secrets at rest (e.g. KSeF certificate password).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KSEF_SECRETS_KEY=<generate one, see above>

KSEF_IMPORT_MODE=http


# KSeF scheduler (domyślnie wyłączony; w Dockerze włączony w .env.docker)
KSEF_SCHEDULER_ENABLED=false
KSEF_SCHEDULE_TIMES=08:00,18:00
KSEF_STARTUP_DELAY_SECONDS=60
